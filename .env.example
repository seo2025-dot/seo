# Copia este archivo a .env.local y rellena los valores de tu proyecto (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publishable-o-anon

# ── Pagos de monedas (ver docs/monedas-y-pagos.md) ──────────────────────────
# Sin estas variables la tienda muestra «Próximamente» en esa pasarela: nada se rompe.
# Clave de SERVICIO de Supabase (Project Settings > API > service_role). SOLO en el servidor; nunca con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# Dirección pública de la app (las pasarelas devuelven aquí a la persona).
# NEXT_PUBLIC_SITE_URL=https://conectari.com
# PayPhone (Ecuador): Botón de pagos. URL de respuesta a registrar: <NEXT_PUBLIC_SITE_URL>/api/pagos/payphone/retorno
# PAYPHONE_TOKEN=
# PAYPHONE_STORE_ID=
# PAYPHONE_IVA_PCT=0
# PayPal (internacional). Webhook a registrar: <NEXT_PUBLIC_SITE_URL>/api/pagos/paypal/webhook (evento PAYMENT.CAPTURE.COMPLETED)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# PAYPAL_WEBHOOK_ID=

# Almacenamiento de fotos de perfil.
#   supabase (por defecto): bucket público "media" de Supabase Storage (producción).
#   local: guarda en la carpeta .media y la sirve en /api/media (solo desarrollo; los datos siguen en Supabase).
# NEXT_PUBLIC_MEDIA_DRIVER=local
# MEDIA_LOCAL_DIR=.media
