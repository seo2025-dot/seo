# Copia este archivo a .env.local y rellena los valores de tu proyecto (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publishable-o-anon

# Almacenamiento de fotos de perfil.
#   supabase (por defecto): bucket público "media" de Supabase Storage (producción).
#   local: guarda en la carpeta .media y la sirve en /api/media (solo desarrollo; los datos siguen en Supabase).
# NEXT_PUBLIC_MEDIA_DRIVER=local
# MEDIA_LOCAL_DIR=.media
